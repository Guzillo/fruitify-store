# ---- Backend ----

# JDBC URL (not postgres://). Used by the API only.
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?user=postgres&password=mysecretpassword

# Public URL of the frontend: Stripe redirects and CORS allowed origin.
APP_DOMAIN=http://localhost:4200

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# JWT signing keys, base64-encoded PEM (generate with `base64 -w0 <file>`)
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY=replace_with_base64_pkcs8_private_key
JWT_PUBLIC_KEY=replace_with_base64_x509_public_key

# ---- Frontend ----

# Backend URL as seen by the browser.
API_URL=http://localhost:8080
